<resources>
    <style name="Theme.IronQuest" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ironquest_orange</item>
        <item name="colorOnPrimary">@color/ironquest_on_orange</item>
        <item name="colorPrimaryContainer">@color/ironquest_orange_container</item>
        <item name="colorOnPrimaryContainer">@color/ironquest_on_orange_container</item>
        <item name="colorSecondary">@color/ironquest_orange_dark</item>
        <item name="colorOnSecondary">@color/ironquest_on_orange</item>
        <item name="colorSecondaryContainer">@color/ironquest_orange_light</item>
        <item name="colorOnSecondaryContainer">@color/ironquest_on_orange_container</item>
        <item name="colorTertiary">@color/ironquest_orange_dark</item>

        <item name="bottomNavigationStyle">@style/Widget.IronQuest.BottomNavigationView</item>
    </style>

    <style name="Widget.IronQuest.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/ironquest_orange</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.IronQuest.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.IronQuest.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ironquest_on_orange</item>
    </style>
</resources>
